@model Libro
@{
    ViewData["Title"] = "Editar libro";
}

<h1 class="h3 mb-3">Editar libro</h1>

<form asp-action="Editar" method="post" class="col-md-7">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="CodLibro" class="form-label"></label>
        <input asp-for="CodLibro" class="form-control" readonly />
        <span asp-validation-for="CodLibro" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CodCategoria" class="form-label"></label>
        @Html.DropDownListFor(m => m.CodCategoria, (IEnumerable<SelectListItem>)ViewBag.Categorias,
            "-- Seleccione una categoría --", new { @class = "form-select" })
        <span asp-validation-for="CodCategoria" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Titulo" class="form-label"></label>
        <input asp-for="Titulo" class="form-control" maxlength="120" />
        <span asp-validation-for="Titulo" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ISBN" class="form-label"></label>
        <input asp-for="ISBN" class="form-control" maxlength="20" />
        <span asp-validation-for="ISBN" class="text-danger"></span>
    </div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="AnioPublicacion" class="form-label"></label>
            <input asp-for="AnioPublicacion" class="form-control" />
            <span asp-validation-for="AnioPublicacion" class="text-danger"></span>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Stock" class="form-label"></label>
            <input asp-for="Stock" class="form-control" />
            <span asp-validation-for="Stock" class="text-danger"></span>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Estado" class="form-label"></label>
            <select asp-for="Estado" class="form-select">
                <option value="1">Activo</option>
                <option value="0">Inactivo</option>
            </select>
            <span asp-validation-for="Estado" class="text-danger"></span>
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Guardar cambios</button>
    <a class="btn btn-secondary" asp-action="Index">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
